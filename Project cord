    elif "fraud" in question:
        return "🤖 Fraud detection uses Machine Learning models like Random Forest and XGBoost to identify suspicious transactions in real-time."
    
    elif "pricing" in question or "dynamic price" in question:
        return "🤖 Dynamic Pricing Engine automatically adjusts product prices based on demand, stock level, and competitor prices to maximize revenue."
    
    elif "forecast" in question or "demand" in question:
        return "🤖 Supply Chain Demand Forecasting predicts future sales using historical data, promotions, and holidays using models like Decision Tree."
    
    elif "model" in question:
        return "🤖 We have trained 4 models: Bank Fraud Model, Dynamic Pricing Model, Demand Forecasting Model, and RAG Chatbot."
    
